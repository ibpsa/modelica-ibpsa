within IBPSA.Fluid.Geothermal.ZonedBorefields.Data;
package Borefield "Collection of borefield data records"
  extends Modelica.Icons.MaterialPropertiesPackage;

  annotation(
    Documentation(info = "<html>
<p>
This package contains data records for use with ground heat exchanger models
in <a href=\"modelica://IBPSA.Fluid.Geothermal.ZonedBorefields\">
IBPSA.Fluid.Geothermal.ZonedBorefields</a>.
The borefield data records contain one of the
<a href=\"modelica://IBPSA.Fluid.Geothermal.ZonedBorefields.Data.Configuration\">
IBPSA.Fluid.Geothermal.ZonedBorefields.Data.Configuration</a> records, one of the
<a href=\"modelica://IBPSA.Fluid.Geothermal.ZonedBorefields.Data.Filling\">
IBPSA.Fluid.Geothermal.ZonedBorefields.Data.Filling</a> records, and one of the
<a href=\"modelica://IBPSA.Fluid.Geothermal.ZonedBorefields.Data.Soil\">
IBPSA.Fluid.Geothermal.ZonedBorefields.Data.Soil</a> records.
</p>
</html>"));
end Borefield;
