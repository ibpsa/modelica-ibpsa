createPlot(id=2, position={644, 58, 624, 646}, x="X_a", y={"eta"}, autoscale = true, grid=true, subPlot=102, colors={{28,108,200}}, timeUnit="1", displayUnits={"Pa.s"});
createPlot(id=2, position={644, 58, 624, 646}, x="X_a", y={"Tf"}, autoscale = true, grid=true, subPlot=103, colors={{28,108,200}}, timeUnit="1", displayUnits={"degC"});
createPlot(id=3, position={1293, 65, 592, 635}, x="X_a", y={"cp"}, autoscale = true, grid=true, subPlot=101, colors={{28,108,200}}, timeUnit="1", displayUnits={"J/(kg.K)"});
createPlot(id=3, position={1293, 65, 592, 635}, x="X_a", y={"lambda"}, autoscale = true, grid=true, subPlot=102, colors={{28,108,200}}, timeUnit="1", displayUnits={"W/(m.K)"});
createPlot(id=3, position={1293, 65, 592, 635}, x="X_a", y={"Pr"}, autoscale = true, grid=true, subPlot=103, colors={{28,108,200}}, timeUnit="1", displayUnits={"1"});
